{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/physics.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,public/**,dist/**,src/**,tests/**,artifacts/**,test-results/**,.git/**,.aws/**,.codex/**,.agents/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/physics?route=:path*" }
  ],
  "headers": [
    {
      "source": "/physics-runtime/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/physics-runtime/:name/pyodide.asm.wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
