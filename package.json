{
  "name": "physica-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-runtime.mjs && tsc -b && vite build",
    "start": "vite preview --host 127.0.0.1 --port 8000 --strictPort",
    "format": "prettier --write src scripts *.ts *.json index.html",
    "format:check": "prettier --check src scripts *.ts *.json index.html",
    "predev": "node scripts/prepare-runtime.mjs",
    "serve:api": "python3 -m server.app --port 8000",
    "dev:server": "node scripts/prepare-runtime.mjs && node scripts/dev.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "pyodide": "314.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.4.0"
  }
}
